# Copiar a .env SOLO en desarrollo local. En QA/producción las variables se
# inyectan desde el gestor de secretos (Vault / AWS Secrets Manager / Azure Key Vault).
NODE_ENV=development
PORT=3000
TOKEN_ISSUER=https://api.banco.example/mse-banca-movil
# Clave privada ES256 PKCS#8 (PEM). Vacía en dev ⇒ clave efímera.
TOKEN_PRIVATE_KEY_PEM=
ACCESS_TOKEN_TTL_SECONDS=300
REFRESH_TOKEN_TTL_SECONDS=1800
RECAUDOS_AUDIENCE=mse-recaudos
STEP_UP_THRESHOLD=500
CORS_ALLOWED_ORIGINS=
STEP_UP_REQUIRE_DEVICE_SIGNATURE=false
